<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Cultures Condition="'$(Cultures)' == ''">en-us</Cultures>
    <OutputName Condition="'$(OutputName)' == ''">DB-Backup-Remote-Sync-$(Version)-$(Cultures)</OutputName>
    <ServicePublishDir Condition="'$(ServicePublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\service</ServicePublishDir>
    <ConfigurationPublishDir Condition="'$(ConfigurationPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\configuration</ConfigurationPublishDir>
    <BrandAssetsDir Condition="'$(BrandAssetsDir)' == ''">$(MSBuildThisFileDirectory)..\assets</BrandAssetsDir>
    <LicenseRtf Condition="'$(Cultures)' == 'ru-ru'">$(MSBuildThisFileDirectory)License.ru-ru.rtf</LicenseRtf>
    <LicenseRtf Condition="'$(LicenseRtf)' == ''">$(MSBuildThisFileDirectory)License.rtf</LicenseRtf>
    <DefineConstants>ProductVersion=$(Version);ServicePublishDir=$(ServicePublishDir);ConfigurationPublishDir=$(ConfigurationPublishDir);BrandAssetsDir=$(BrandAssetsDir);LicenseRtf=$(LicenseRtf)</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer-staging\$(Cultures)</OutputPath>
    <SuppressValidation>false</SuppressValidation>
    <SuppressSpecificWarnings>1149</SuppressSpecificWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
